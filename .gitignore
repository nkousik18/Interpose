# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Env / secrets
.env
.env.*
!.env.example

# Data (large / regenerable — see data/README.md for how to fetch it).
# Raw datasets live outside the repo at ~/.interpose/data/, never here — this only
# guards against someone accidentally dropping a raw file into ./data/ locally.
data/*.csv
data/*.parquet
data/*.txt

# Terraform
terraform/**/.terraform/
terraform/**/*.tfstate
terraform/**/*.tfstate.*
# Lock files ARE meant to be committed for a real root module (examples/minimal/'s
# own .terraform.lock.hcl stays tracked, per standard Terraform practice and
# versions.tf's own comment) -- only the reusable module's own incidental one
# (generated by validating it standalone, never how it's actually consumed) is
# ignored here.
terraform/aws-eks/.terraform.lock.hcl

# Helm
charts/**/charts/
charts/**/*.tgz

# IDE / OS
.DS_Store
.vscode/
.idea/

# Logs
*.log

# Local dev cluster (scripts/dev-up.sh / dev-down.sh)
.dev-up.pids

# Generated evaluation report (scripts/run_eval_report.py) -- a real, regenerable
# artifact, not source; CI uploads its own copy per run rather than committing one.
eval_report.json
